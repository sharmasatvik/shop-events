    <!--
      The shared event contract. Plain Java records, no Spring, no Kafka.
      Every service depends on this jar, so producer and consumer agree on field names.
      In a bigger company this role is played by a schema registry (Avro/Protobuf).
    -->
    <artifactId>events</artifactId>
    <packaging>jar</packaging>
